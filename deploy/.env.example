# Variáveis de produção. Não preencha à mão: rode ./init-env.sh, que gera os segredos.
# Este arquivo é o modelo; o deploy/.env de verdade não vai para o git.

# Domínio que aponta para o servidor (registro A no DNS) e e-mail para avisos do Let's Encrypt
DOMAIN=zeladoria.exemplo.com.br
ACME_EMAIL=ti@exemplo.com.br

# Bancos e mensageria: só a rede interna do Docker os alcança
POSTGRES_DB=spbemestar
POSTGRES_USER=spbemestar
POSTGRES_PASSWORD=
RABBITMQ_USER=spbemestar
RABBITMQ_PASSWORD=
MONGO_DB=spbemestar
MONGO_USER=spbemestar
MONGO_PASSWORD=

# Assinatura dos tokens e HMAC do autor dos relatos (32 bytes ou mais). Trocar REPORTER_HASH separa os
# relatos antigos dos novos do mesmo cidadão; trocar JWT_SECRET desconecta todo mundo.
JWT_SECRET=
REPORTER_HASH=

# Primeiro usuário, criado como administrador na primeira subida. Sem senha: ele entra com o código que chega
# no e-mail
OPERATOR_EMAIL=
OPERATOR_NAME=Administrador

# Conta do CEO, a única que abre o painel de métricas e saúde em /ceo. Fica fora da equipe da prefeitura.
CEO_EMAIL=
CEO_NAME=CEO

# Envio do código de acesso pelo Brevo (https://www.brevo.com): a chave em Configurações › Chaves SMTP e API e
# o remetente confirmado em Remetentes. Sem os dois, ninguém consegue entrar.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=SP Bem-Estar

# Notificações push (Web Push). Trocar o par desliga as inscrições já feitas.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:ti@exemplo.com.br

# Página de privacidade: órgão responsável pelos dados e contato do encarregado (DPO)
PRIVACY_CONTROLLER=
PRIVACY_CONTACT=

# Swagger UI desligado em produção
API_DOCS_ENABLED=false

# Usuário do Prometheus no /actuator/prometheus (o Caddy já bloqueia esse caminho de fora)
METRICS_USER=prometheus
METRICS_PASSWORD=

# Worker de classificação (perfil "classifier")
CLASSIFIER_MODEL_VERSION=v1
# Usuário que a API usa para conferir a foto no worker na hora do envio (gerado pelo init-env.sh)
CLASSIFIER_API_USER=api
CLASSIFIER_API_PASSWORD=
